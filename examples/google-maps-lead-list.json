    {
      "parameters": {
        "jsCode": "// One item per results page (20 places each), up to 5 pages\nconst f = $input.first().json;\nconst pages = Math.min(Math.max(parseInt(f['Pages to fetch'], 10) || 1, 1), 5);\nconst query = `${f['Business type']} in ${f['Location']}`.trim();\nreturn Array.from({ length: pages }, (_, i) => ({ json: { query, page: i + 1 } }));"
      },
      "id": "22b95a5e-9bed-4f34-ab0f-6b7973b2f498",
      "name": "Build page list",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        80
      ]
    },
    {
      "parameters": {
        "resource": "google-maps",
        "operation": "/google-maps/v1/search",
        "p_q": "={{ $json.query }}",
        "p_page": "={{ $json.page }}",
        "p_limit": 20,
        "options": {
          "split": true
        }
      },
      "id": "dc53e32f-77f3-417c-8084-c9778cfcd8eb",
      "name": "Search Google Maps",
      "type": "n8n-nodes-apish.apish",
      "typeVersion": 1,
      "position": [
        540,
        80
      ],
      "credentials": {
        "apishApi": {
          "id": "",
          "name": "API.SH API"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Keeps the places that meet the form's criteria and shapes one sheet row each\nconst f = $('Lead search form').first().json;\nconst minRating = Number(f['Minimum rating']) || 0;\nconst needWebsite = f['Website required'] === 'Yes';\nconst seen = new Set();\nconst out = [];\nfor (const item of $input.all()) {\n  const p = item.json;\n  if (p.error || !p.place_id || seen.has(p.place_id)) continue;\n  seen.add(p.place_id);\n  if (p.permanently_closed) continue;\n  if ((Number(p.stars) || 0) < minRating) continue;\n  if (needWebsite && !p.website) continue;\n  out.push({ json: {\n    place_id: p.place_id, name: p.name, category: p.category || '', phone: p.phone_international || p.phone || '',\n    website: p.website || '', domain: p.website_domain || '', address: p.full_address || p.address || '',\n    city: p.city || '', rating: p.stars ?? '', reviews: p.review_count ?? '', maps_url: p.url || '',\n    search: $('Build page list').first().json.query, found_at: new Date().toISOString(),\n  } });\n}\nreturn out;"
      },
      "id": "ab58a1f2-fd1a-4c09-a0e3-24fbce5e731d",
