      "id": "e703cbea-bc14-4e27-81bf-7ebd55ca2a91",
      "name": "Save latest prices",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1100,
        -60
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// One email for all alerts of this run (nothing is sent when there are none)\nconst alerts = $input.all().map((i) => i.json).filter((p) => p.alert);\nif (!alerts.length) return [];\nconst lines = alerts.map((p) => {\n  const was = p.previous_price !== '' ? ` (was ${p.previous_price}, ${p.change_percent}%)` : '';\n  const target = p.status === 'below target' ? ` - below your target of ${p.target_price}` : '';\n  return `- ${p.title}\\n  now ${p.last_price}${was}${target}\\n  ${p.url}`;\n});\nreturn [{ json: {\n  subject: `${alerts.length} Amazon price alert${alerts.length > 1 ? 's' : ''}`,\n  body: `Prices checked ${new Date().toUTCString()}:\\n\\n${lines.join('\\n\\n')}`,\n} }];"
      },
      "id": "ba035ad0-4eb2-484c-86d6-d14dbfaf7997",
      "name": "Build alert digest",
      "type": "n8n-nodes-base.code",
