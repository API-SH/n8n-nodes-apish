      "name": "Every morning",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        40,
        60
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "27dcc90b-f329-47a4-8f4e-7545a4e374c3",
              "name": "alert_email",
              "value": "you@example.com",
              "type": "string"
            },
            {
              "id": "25c9af36-a5ac-4e3a-b34d-83262489bd07",
