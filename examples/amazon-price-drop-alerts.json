              "value": 5,
              "type": "number"
            },
            {
              "id": "cce8f91e-45db-4386-a3e4-e87e01e86cc0",
              "name": "zip",
              "value": "10001",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "553a699a-57ce-4fd5-839f-16a233b12995",
      "name": "Settings",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
