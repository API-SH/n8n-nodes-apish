      "id": "ab1c82fa-1d56-42d7-8d17-230be892eb04",
      "name": "Read tracked products",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        360,
        60
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "resource": "amazon",
        "operation": "/amazon/v1/product",
        "p_url": "={{ $json.url }}",
        "p_zip": "={{ $('Settings').first().json.zip }}",
        "options": {}
      },
      "id": "fb261443-36ed-480f-a85f-3ccef2a9a9bb",
      "name": "Get Amazon product",
      "type": "n8n-nodes-apish.apish",
      "typeVersion": 1,
      "position": [
        600,
        60
      ],
      "credentials": {
        "apishApi": {
          "id": "",
          "name": "API.SH API"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Pairs each product row from the sheet with its API.SH result (same order)\n// and works out the price change since the last run.\nconst rows = $('Read tracked products').all();\nconst settings = $('Settings').first().json;\nconst threshold = Number(settings.drop_alert_percent) || 5;\nconst now = new Date().toISOString();\n\nreturn $input.all().map((item, i) => {\n  const row = rows[i]?.json ?? {};\n  const p = item.json;\n  const previous = Number(row.last_price) || null;\n  const target = Number(row.target_price) || null;\n  const price = typeof p.price_value === 'number' ? p.price_value : null;\n\n  // A failed lookup or a hidden price keeps the old values and says why\n  if (p.error || price === null) {\n    return { json: {\n      url: row.url, title: row.title || p.title || '', target_price: row.target_price ?? '',\n      last_price: row.last_price ?? '', previous_price: row.previous_price ?? '', change_percent: '',\n      availability: p.error ? 'lookup failed' : (p.availability || 'no price shown'),\n      last_checked: now, status: p.error ? `error: ${p.error}` : 'no price', alert: false,\n    } };\n  }\n\n  const change = previous ? Math.round(((price - previous) / previous) * 1000) / 10 : null;\n  const dropped = change !== null && change <= -threshold;\n  const belowTarget = target !== null && price <= target && (previous === null || previous > target);\n  return { json: {\n    url: row.url, title: p.title, target_price: row.target_price ?? '',\n    last_price: price, previous_price: previous ?? '', change_percent: change ?? '',\n    availability: p.availability || '', last_checked: now,\n    status: dropped ? 'price drop' : belowTarget ? 'below target' : 'ok',\n    alert: dropped || belowTarget,\n  } };\n});"
      },
      "id": "61f6694a-87eb-49f2-92c2-301194a896a7",
      "name": "Compare with last price",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        860,
