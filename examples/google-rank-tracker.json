    {
      "parameters": {
        "jsCode": "// One email listing the keywords that dropped or fell out (nothing is sent otherwise)\nconst s = $('Settings').first().json;\nconst bad = $input.all().map((i) => i.json).filter((k) => k.dropped || k.lost);\nif (!bad.length) return [];\nconst lines = bad.map((k) => k.lost\n  ? `- \"${k.keyword}\": fell out of the top ${s.results_to_check} (was #${k.previous_position})`\n  : `- \"${k.keyword}\": #${k.previous_position} -> #${k.position} (${k.change})`);\nreturn [{ json: { subject: `Ranking drops for ${s.my_domain}: ${bad.length} keyword${bad.length > 1 ? 's' : ''}`, body: lines.join('\\n') } }];"
      },
