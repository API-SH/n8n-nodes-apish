      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Finds your domain in each keyword's results and compares with the last run\nconst s = $('Settings').first().json;\nconst domain = String(s.my_domain).toLowerCase().replace(/^https?:\\/\\//, '').replace(/^www\\./, '').replace(/\\/.*$/, '');\nconst rows = $('Read keywords').all();\nconst today = new Date().toISOString().slice(0, 10);\nconst host = (u) => (String(u || '').match(/^https?:\\/\\/([^/?#:]+)/i)?.[1] || '').replace(/^www\\./, '').toLowerCase();\n\nreturn $input.all().map((item, i) => {\n  const row = rows[i].json;\n  const r = item.json;\n  const results = Array.isArray(r.results) ? r.results : [];\n  const mine = results.find((x) => { const h = host(x.url); return h === domain || h.endsWith('.' + domain); });\n  const position = mine ? mine.position : null;\n  const last = Number(row.last_position) || null;\n  const change = position && last ? last - position : null; // positive = moved up\n  return { json: {\n    row_number: row.row_number, keyword: row.keyword, date: today,\n    position: position ?? (r.error ? '' : `not in top ${s.results_to_check}`),\n    url: mine?.url || '', previous_position: last ?? '', change: change ?? '',\n    top_result: results[0] ? host(results[0].url) : '', error: r.error || '',\n    numeric_position: position, lost: !!last && !position && !r.error,\n    dropped: change !== null && change <= -Number(s.alert_drop_positions || 3),\n  } };\n});"
      },
