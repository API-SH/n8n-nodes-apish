    {
      "parameters": {
        "jsCode": "// One item per handle to look up: @handles, plain usernames and profile URLs all work.\n// Empty cells are skipped, so no credits are spent on them.\nconst handle = (v) => String(v || '').trim()\n  .replace(/^https?:\\/\\/(www\\.)?(tiktok|instagram)\\.com\\/@?/i, '')\n  .replace(/[/?#].*$/, '').replace(/^@/, '');\nconst out = [];\nfor (const item of $input.all()) {\n  for (const network of ['tiktok', 'instagram']) {\n    const h = handle(item.json[network]);\n    if (h) out.push({ json: { row_number: item.json.row_number, network, handle: h } });\n  }\n}\nreturn out;"
      },
