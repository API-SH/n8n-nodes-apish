    {
      "parameters": {
        "jsCode": "// Groups both profiles by sheet row: reach, size tier and a simple engagement signal\nconst rows = new Map();\n$input.all().forEach((item, i) => {\n  const src = $('Clean handles').itemMatching(i).json;\n  const row = rows.get(src.row_number) ?? { row_number: src.row_number };\n  row[src.network] = item.json;\n  rows.set(src.row_number, row);\n});\nconst tier = (n) => n >= 1e6 ? 'mega' : n >= 5e5 ? 'macro' : n >= 1e5 ? 'mid' : n >= 1e4 ? 'micro' : n > 0 ? 'nano' : '';\n\nreturn [...rows.values()].map(({ row_number, tiktok: tt = {}, instagram: ig = {} }) => {\n  const ttFollowers = Number(tt.followers) || 0;\n  const igFollowers = Number(ig.followers) || 0;\n  // TikTok likes per video against followers: a rough signal of how engaged the audience is\n  const likesPerVideo = tt.videos ? Math.round(Number(tt.likes || 0) / Number(tt.videos)) : null;\n  const engagement = likesPerVideo !== null && ttFollowers ? Math.round((likesPerVideo / ttFollowers) * 10000) / 100 : '';\n  const notes = [tt.error && `TikTok: ${tt.error}`, ig.error && `Instagram: ${ig.error}`, tt.private && 'TikTok private', ig.is_private && 'Instagram private'].filter(Boolean);\n  return { json: {\n    row_number,\n    tiktok_followers: ttFollowers || '', tiktok_videos: tt.videos ?? '', tiktok_likes_per_video: likesPerVideo ?? '',\n    tiktok_engagement_percent: engagement, tiktok_verified: tt.verified ?? '',\n    instagram_followers: igFollowers || '', instagram_verified: ig.is_verified ?? '', instagram_bio: ig.bio || '',\n    total_reach: ttFollowers + igFollowers, tier: tier(Math.max(ttFollowers, igFollowers)),\n    notes: notes.join('; '), checked_at: new Date().toISOString(),\n  } };\n});"
      },
